{
  "name": "proofwall",
  "private": true,
  "version": "0.1.0",
  "description": "Сбор видео-отзывов и «Стена любви» — клон Senja.io",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:widget": "npm run build --workspace apps/widget && node scripts/copy-widget-to-public.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace packages/db",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "dz": "dz",
    "openspec": "openspec",
    "process:install": "sh scripts/install-process.sh"
  },
  "devDependencies": {
    "@dzhechkov/harness-cli": "0.8.58",
    "@dzhechkov/skills-feature-adr": "1.5.25",
    "@fission-ai/openspec": "1.15.0",
    "node": "22.23.4"
  }
}
